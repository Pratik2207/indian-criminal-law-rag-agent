# Ollama (local LLM)
OLLAMA_BASE_URL="http://localhost:11434"
# qwen2.5:3b fits fully in 4 GB VRAM: ~14 s per answer, 90% gold-cited in evals. With 8 GB+ VRAM, qwen3:8b (97%).
OLLAMA_MODEL="qwen2.5:3b"
# Context window; prompts peak at ~3.9k tokens. Smaller = more of the model fits on the GPU.
OLLAMA_NUM_CTX=6144

# Qdrant: local files by default; set QDRANT_URL to use a server (e.g. docker run -p 6333:6333 qdrant/qdrant)
QDRANT_DB_PATH="./qdrant_db"
QDRANT_URL=""
QDRANT_COLLECTION_NAME="indian_law_v2"

# Retrieval: dense | hybrid | hybrid_rerank (the app always adds query analysis on top)
RETRIEVAL_MODE="hybrid_rerank"
TOP_K=6
# Reranker score below which the assistant abstains (calibrated with evals/retrieval_eval.py)
ABSTAIN_THRESHOLD=-4.0

# Optional: web search via Serper (results are filtered to trusted legal sites and cited with links)
SERPER_API_KEY=""
# Optional: case law via Indian Kanoon API (https://api.indiankanoon.org/), free credits for non-commercial use
INDIAN_KANOON_API_TOKEN=""
